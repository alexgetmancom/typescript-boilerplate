NODE_ENV=development
APP_NAME=typescript-boilerplate

# Local development default. Compose uses http-only when BOT_MODE is omitted.
# Set polling or webhook here only when the corresponding Telegram credentials are configured.
BOT_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=
TELEGRAM_ALLOWED_USER_IDS=

DATABASE_URL=./data/app.db
PORT=8080
BIND_HOST=127.0.0.1
